<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>The Devil's Trial</display-name>

    <context-param>
        <param-name>google.clientId</param-name>
        <param-value>YOUR_GOOGLE_CLIENT_ID</param-value>
    </context-param>

    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.devilstrial.auth.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>GoogleAuthServlet</servlet-name>
        <servlet-class>com.devilstrial.auth.GoogleAuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoogleAuthServlet</servlet-name>
        <url-pattern>/auth/google</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FetchQuestionServlet</servlet-name>
        <servlet-class>com.devilstrial.game.FetchQuestionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FetchQuestionServlet</servlet-name>
        <url-pattern>/game/question</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ValidateAnswerServlet</servlet-name>
        <servlet-class>com.devilstrial.game.ValidateAnswerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ValidateAnswerServlet</servlet-name>
        <url-pattern>/game/validate</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SaveProgressServlet</servlet-name>
        <servlet-class>com.devilstrial.game.SaveProgressServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SaveProgressServlet</servlet-name>
        <url-pattern>/game/progress</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FetchLeaderboardServlet</servlet-name>
        <servlet-class>com.devilstrial.game.FetchLeaderboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FetchLeaderboardServlet</servlet-name>
        <url-pattern>/game/leaderboard</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>60</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>
</web-app>
