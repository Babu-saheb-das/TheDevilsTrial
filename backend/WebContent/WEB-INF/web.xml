<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- 1. Fetch Question Servlet Setup -->
    <servlet>
        <servlet-name>FetchQuestionServlet</servlet-name>
        <servlet-class>com.devilstrial.game.FetchQuestionServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FetchQuestionServlet</servlet-name>
        <url-pattern>/api/get-question</url-pattern>
    </servlet-mapping>

    <!-- 2. Validate Answer Servlet Setup -->
    <servlet>
        <servlet-name>ValidateAnswerServlet</servlet-name>
        <servlet-class>com.devilstrial.game.ValidateAnswerServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ValidateAnswerServlet</servlet-name>
        <url-pattern>/api/validate-answer</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SaveProgressServlet</servlet-name>
        <servlet-class>com.devilstrial.game.SaveProgressServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SaveProgressServlet</servlet-name>
        <url-pattern>/api/save-progress</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>FetchLeaderboardServlet</servlet-name>
        <servlet-class>com.devilstrial.game.FetchLeaderboardServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FetchLeaderboardServlet</servlet-name>
        <url-pattern>/api/get-leaderboard</url-pattern>
    </servlet-mapping>

</web-app>